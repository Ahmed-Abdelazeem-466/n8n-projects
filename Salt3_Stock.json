    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  \n  const rawMessage = item.json.message?.text || item.json.text || \"\";\n\n  // NEW Regex breakdown:\n  // ^(\\d+)    -> Grabs the number at the beginning (e.g., \"15\")\n  // \\s+(\\S+)  -> Skips the space, then grabs the next single word (e.g., \"jar\")\n  // \\s+(.+)$  -> Skips the space, then grabs the entire rest of the message (e.g., \"Pickles\")\n  const match = rawMessage.trim().match(/^(\\d+)\\s+(\\S+)\\s+(.+)$/);\n\n  if (match) {\n    // If the message perfectly matches our 3-part format:\n    item.json.quantity = parseInt(match[1], 10); // Forces it into an Integer (15)\n    item.json.unit = match[2].trim();            // The container type (\"jar\")\n    item.json.itemName = match[3].trim();        // The rest of the string (\"Pickles\")\n  } else {\n    // Fallback just in case the message format is wrong\n    item.json.quantity = null; \n    item.json.unit = \"\";\n    item.json.itemName = rawMessage.trim();\n  }\n}\n\nreturn $input.all();"
      },
