    {
      "parameters": {
        "jsCode": "// Loop over all incoming items from the Telegram trigger\nfor (const item of $input.all()) {\n  \n  // Safely grab the incoming message text\n  const rawMessage = item.json.message?.text || item.json.text || \"\";\n\n  // Regex breakdown:\n  // ^(\\d+) grabs the numbers at the beginning (e.g., \"4\")\n  // \\s+ skips the space\n  // (.+)$ grabs the rest of the message as the string (e.g., \"cancel\" or \"Done\")\n  const match = rawMessage.trim().match(/^(\\d+)\\s+(.+)$/);\n\n  if (match) {\n    // If the message perfectly matches our 2-part format:\n    item.json.targetNumber = parseInt(match[1], 10); // Forces it into an Integer (4)\n    item.json.actionText = match[2].trim();          // Keeps the text as a String (\"cancel\" or \"Done\")\n  } else {\n    // Fallback just in case the format is wrong\n    item.json.targetNumber = null; \n    item.json.actionText = rawMessage.trim();\n  }\n}\n\n// Return the items to pass along to the next node\nreturn $input.all();"
      },
